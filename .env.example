# 玄镜 OracleMind · AI 服务配置（Python 版）
#
# 用法：复制本文件为 .env 后填入真实密钥。
#   cp .env.example .env
# .env 已在 .gitignore 中，切勿提交到版本库。

# ----- 服务 -----
# 固定端口 8021：与前端 oraclemind/.env.local 的 NEXT_PUBLIC_AI_API_BASE 对齐。
# 请勿随意改动，否则前端会连不上；启停一律用 scripts/ai_server.py，避免孤儿端口。
PORT=8021
APP_ENV=development
# 严禁开启 reload：reload 会派生 reloader+worker 双进程，worker 易变孤儿监听占死端口。
# 改代码后用 scripts/ai_server.py restart 重启即可。
AI_RELOAD=false
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://[::1]:3000
# 绑定地址：默认 127.0.0.1（仅本机回环）；公网部署务必经 Nginx 反代，切勿直接 0.0.0.0 暴露
AI_BIND_HOST=127.0.0.1
# 服务调用 API Key（可选）：配置后所有非白名单接口须带 X-API-Key 头；留空=开发模式不校验
AI_SERVICE_API_KEY=

# ----- LLM 供应商（主：智谱 GLM-4-Flash） -----
AI_PROVIDER=zhipu
AI_MODEL_CHAT=glm-4-flash
AI_MODEL_LITE=glm-4-flash
# 必填：在智谱开放平台 https://open.bigmodel.cn 申请，切勿提交到版本库
AI_API_KEY=
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ----- 备用供应商（阿里通义，可选） -----
AI_PROVIDER_FALLBACK=aliyun
AI_MODEL_FALLBACK=qwen-max
# 可选：留空则主供应商失败时直接降级到规则兜底
AI_API_KEY_FALLBACK=
AI_BASE_URL_FALLBACK=https://ws-0q1asnif44n77cn8.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# ----- 请求参数 -----
AI_TTFT_TIMEOUT_MS=10000
# 非流式结构化调用总超时；GLM-4-Flash 长 JSON 输出较慢，建议不低于 90000
AI_TOTAL_TIMEOUT_MS=90000
AI_RATE_LIMIT_RPS=20
# 流式响应单 chunk 最大不活跃超时（秒）：超过则本次流式提前结束，避免上游 stall 导致请求永久挂起
STREAM_TIMEOUT_SECONDS=60

# ----- 缓存 -----
# 全站去缓存命中：设为 1 时禁用所有计算结果缓存（占星/解读/合盘等每次重新计算）
# 默认 0：开启缓存。同样的入参（module + result_json + focus）会秒回上次结果。
# 调试 / 改 prompt 时临时设 1，验证完恢复 0 即可。
DISABLE_CACHE=0
# 留空则自动降级到「内存 + JSON 落盘」兜底，单实例运行完全不需要 Redis
REDIS_URL=redis://localhost:6379/0

# ----- 成本控制 -----
BUDGET_DAY_YUAN=5
AI_PRICE_INPUT_PER_1K=0.001
AI_PRICE_OUTPUT_PER_1K=0.002

# ----- 排盘服务 -----
PAIPAN_API_BASE=http://localhost:8000

# ----- 检索增强（RAG） -----
RETRIEVAL_ENABLED=true
RETRIEVAL_TOPK=6

# ----- Chroma 向量数据库 -----
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=oraclemind_kb
# Embedding 模型（兼容 OpenAI 接口；智谱 embedding-3 或 OpenAI text-embedding-3-small）
# 留空则回退到 Chroma 本地默认模型（all-MiniLM-L6-v2，首次运行会下载约 80MB）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3

# ============================================================================
# ⚠️ Vercel / 生产部署追加注记（详见 DEPLOYMENT.md）
# ============================================================================
# 1) 端口无关：Vercel 由 ASGI 协议驱动 api/index.py:app，PORT 仅在本地 uvicorn 生效，可忽略。
# 2) 持久化目录必须可写：Vercel 运行时仅 /tmp 可写，代码目录只读。
#    - 缓存/预算落盘（data/*.json）已用 try/except 静默降级为内存缓存，不影响可用性；
#    - RAG 检索增强若开启，CHROMA_PERSIST_DIR 必须指向 /tmp，否则首请求建库会失败：
#      CHROMA_PERSIST_DIR=/tmp/oraclemind_chroma
# 3) 缓存建议走 Redis：配 REDIS_URL=rediss://<upstash-host>（Vercel 上用 Upstash），
#    避免依赖本地落盘（否则多实例/冷启动命中率低）。
# 4) APP_ENV=production 时，CORS_ORIGINS 务必加上前端域名（否则浏览器跨域被拦）。
# 5) 体积风险：chromadb 传递依赖（kubernetes/onnxruntime/chromadb_rust_bindings/numpy）
#    极易逼近/超过 Vercel 函数 500MB 上限。若部署到 Vercel，建议优先把 AI 服务放在
#    Railway / Render / Fly.io 等支持持久盘、无 500MB 硬限制的主机；或关闭 RAG（RETRIEVAL_ENABLED=false）。

