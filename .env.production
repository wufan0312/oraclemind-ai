# ============================================================================
# 玄镜 AI 服务 · 生产环境（APP_ENV=production 时自动加载，Vercel 上生效）
#
# 本文件已提交到仓库，是生产的「兜底默认值」；
# Vercel 项目面板里配的同名变量优先级更高，会覆盖这里的取值。
#
# ⚠️ 这里刻意**不写任何密钥**。以下必须在 Vercel 面板配置，否则解读会走降级文案：
#    AI_API_KEY          —— 智谱 API Key（缺它 /health 里 llm_available 就是 false）
#    EMBEDDING_API_KEY   —— 仅 RAG 开启时需要
#    REDIS_URL           —— 可选（Upstash，rediss:// 带 TLS）；不配则降级为内存缓存
#    AI_SERVICE_API_KEY  —— 留空即不校验（前端无需带 X-API-Key 头）
# ============================================================================

# ----- 服务 -----
APP_ENV=production
AI_RELOAD=false
LOG_LEVEL=info
AI_BIND_HOST=127.0.0.1
# 线上前端域名（多个用逗号分隔，不带尾部斜杠）
CORS_ORIGINS=https://oraclemind-frontend.vercel.app

# ----- LLM 供应商 -----
AI_PROVIDER=zhipu
AI_MODEL_CHAT=glm-4-flash
AI_MODEL_LITE=glm-4-flash
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ----- 备用供应商 -----
AI_PROVIDER_FALLBACK=aliyun
AI_MODEL_FALLBACK=qwen-max
AI_BASE_URL_FALLBACK=https://ws-0q1asnif44n77cn8.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# ----- 请求参数 -----
# ⚠️ vercel.json 里 api/index.py 的 maxDuration=60（Hobby 上限），
#    所以总超时必须留足余量 < 60s，否则函数被平台掐断、前端只看到「解读暂不可用」。
#    本地 .env.development 是 90000（无平台限制），两边刻意不同。
AI_TTFT_TIMEOUT_MS=10000
AI_TOTAL_TIMEOUT_MS=55000
AI_RATE_LIMIT_RPS=20

# ----- 缓存 -----
DISABLE_CACHE=0

# ----- 成本控制 -----
BUDGET_DAY_YUAN=5
AI_PRICE_INPUT_PER_1K=0.001
AI_PRICE_OUTPUT_PER_1K=0.002

# ----- 排盘服务（后端 Vercel 域名）-----
# 已上线：2026-09-15 实测 GET https://oraclemind-backend.vercel.app/api/health → 200
# 填根路径，不含 /api。注意别用 preview 域名（形如 xxx-hash-user.vercel.app），
# 那些部署默认开着 Vercel SSO，服务端 fetch 会被 302 到 vercel.com/sso-api。
PAIPAN_API_BASE=https://oraclemind-backend.vercel.app

# ----- 检索增强（RAG）-----
# 生产默认关闭：Vercel 是只读 + 临时文件系统，Chroma 索引每次冷启动都要重建，
# 既拖慢冷启动又占 Bundle 体积（500MB 上限风险）。需要开启时：
#   1) 面板设 RETRIEVAL_ENABLED=true，并确保 Embedding key 已配；
#   2) 把 CHROMA_PERSIST_DIR 指到 /tmp（serverless 唯一可写目录）；
#   3) 确认部署体积仍在 Vercel 限制内。
RETRIEVAL_ENABLED=false
RETRIEVAL_TOPK=6

# ----- Chroma 向量库 -----
CHROMA_PERSIST_DIR=/tmp/chroma
CHROMA_COLLECTION=oraclemind_kb
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
