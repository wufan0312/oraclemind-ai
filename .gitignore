# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# 虚拟环境
.venv/
venv/

# 环境变量（含 API Key / 密钥，禁止提交）
.env
.env.local
.env.prod
.env.*.local
# 注：.env.development / .env.production 是「按 APP_ENV 分发的非敏感默认值」，
# 已随仓库提交（克隆即用）。密钥一律走 Vercel 面板，或本地 .env。

# 运行时数据（缓存 / 预算 / 向量库，均为本地产物）
data/cache_store.json
data/budget_store.json
data/cache_store.tmp
data/budget_store.tmp
data/chroma/

# 测试与工具
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 服务日志
oj_*.log
*.log

# 临时脚本（_ 前缀的一次性验证脚本）
_*.py
!scripts/

# IDE
.idea/
.vscode/
*.swp

# 系统
.DS_Store
Thumbs.db

# 生成物归位目录（截图/html/json/日志等本地产物，勿提交；以后这类文件统一放这里）
outputs/
