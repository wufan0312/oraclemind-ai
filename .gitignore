# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# 虚拟环境
.venv/
venv/

# 环境变量（含 API Key / 密钥，禁止提交）
.env
.env.local
.env.prod
.env.*.local
# ?? 切勿写 ".env.*" 通配：那会把 .env.example / .env.development / .env.production
#    一起忽略掉。这三个是「按 APP_ENV 分发的非敏感默认值」，按 src/config.py 设计
#    应随仓库提交（克隆即用）；密钥一律走 Vercel 面板或本地 .env。
#    一旦漏提交，Vercel 从 git 拉取时就拿不到分层配置，config.py 只能静默回落代码默认值
#    （PAIPAN_API_BASE 变 localhost:8000、CORS 只剩 localhost、RETRIEVAL_ENABLED 变 true）。

# 运行时数据（缓存 / 预算 / 向量库，均为本地产物）
data/cache_store.json
data/budget_store.json
data/cache_store.tmp
data/budget_store.tmp
data/chroma/

# 测试与工具
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 服务日志
oj_*.log
*.log

# 临时脚本（`_` 前缀的一次性验证脚本）
# ?? 切勿去掉下面这行否定规则：gitignore 语义下 "_*.py" 会连 __init__.py 一起匹配，
#    一旦 __init__.py 被忽略，Vercel 从 git 拉取的产物里就没有它们 →
#    src/ 下所有子包退化为 namespace package，包内初始化静默失效
#    （典型报错：ImportError: cannot import name 'route_trace' from 'src.harness' (unknown location)）。
_*.py
!**/__init__.py
!scripts/

# IDE
.idea/
.vscode/
*.swp

# 系统
.DS_Store
Thumbs.db

# 生成物归位目录（截图 / html / json / 日志等本地产物，勿提交）
outputs/
