# ============================================================================
# 玄镜 AI 服务 · 本地开发环境（APP_ENV=development 时自动加载）
#
# 本文件已提交到仓库，只放非敏感配置。
# API Key 等密钥写在 .env（gitignore），它的优先级低于本文件，不会被冲掉。
#
# 优先级（高 → 低）：真实环境变量 > .env.development > .env
# ============================================================================

# ----- 服务 -----
# 固定端口 8021：与前端 .env.development 的 NEXT_PUBLIC_AI_API_BASE 对齐。
# 改动本端口必须同步前端并重启两端（NEXT_PUBLIC_* 是构建期内联）。
PORT=8021
APP_ENV=development
# 严禁开启 reload：会派生 reloader+worker 双进程，worker 易变孤儿占死端口。
# 改代码用 scripts/ai_server.py restart。
AI_RELOAD=false
LOG_LEVEL=info
# 仅监听本机回环（安全）；确需跨机访问再改 0.0.0.0
AI_BIND_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://[::1]:3000

# ----- LLM 供应商（主：智谱 GLM-4-Flash）-----
AI_PROVIDER=zhipu
AI_MODEL_CHAT=glm-4-flash
AI_MODEL_LITE=glm-4-flash
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ----- 备用供应商（阿里通义 / 百炼兼容模式）-----
# 注意 ai_model_fallback 必须是有效标识：旧的 qwen3.6-27b 在通义命名规范中
# 不存在，会导致 fallback 必败（安全缺陷报告 BUG-01）。
AI_PROVIDER_FALLBACK=aliyun
AI_MODEL_FALLBACK=qwen-max
AI_BASE_URL_FALLBACK=https://ws-0q1asnif44n77cn8.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# ----- 请求参数 -----
AI_TTFT_TIMEOUT_MS=10000
# 非流式结构化调用（summary / 模块解读）总超时：GLM-4-Flash 长 JSON 常达 40-60s，
# 30s 会大面积 TimeoutError → 前端显示「解读暂不可用」。
AI_TOTAL_TIMEOUT_MS=90000
AI_RATE_LIMIT_RPS=20

# ----- 缓存 -----
# 1 = 全站禁用缓存（改 prompt 调试时用），0 = 开启
DISABLE_CACHE=0

# ----- 成本控制 -----
BUDGET_DAY_YUAN=5
AI_PRICE_INPUT_PER_1K=0.001
AI_PRICE_OUTPUT_PER_1K=0.002

# ----- 排盘服务（本地后端）-----
PAIPAN_API_BASE=http://localhost:8000

# ----- 检索增强（RAG）-----
RETRIEVAL_ENABLED=true
RETRIEVAL_TOPK=6

# ----- Chroma 向量库 -----
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=oraclemind_kb
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
